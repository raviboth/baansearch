{
  "name": "baansearch",
  "version": "1.0.0",
  "description": "Job search link aggregator for tech professionals",
  "scripts": {
    "build": "esbuild src/app.ts --bundle --outfile=dist/bundle.js --minify --sourcemap",
    "dev": "esbuild src/app.ts --bundle --outfile=dist/bundle.js --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "esbuild": "^0.27.2",
    "jsdom": "^27.4.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "job-search",
    "tech-jobs",
    "aggregator"
  ],
  "license": "MIT"
}
